/**
 * Cloudflare Workers configuration for the Himalayan Koh storefront.
 *
 * Generated by `vinext init --platform=cloudflare` and then owned here. The
 * deployment reads `dist/server/wrangler.json`, which vinext derives from this
 * file, so bindings added here reach the deployed Worker.
 *
 * Secrets deliberately do **not** live here — `vars` below is readable by
 * anyone with the deployment, so it holds only public values. The server-side
 * credentials (WooCommerce consumer key/secret, Supabase service role, Shippo)
 * are set with `wrangler secret put` and are never written to a file that git
 * tracks. See docs/CLOUDFLARE-MIGRATION.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "himalayan-koh-ecommerce",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  /**
   * The `/blog` route is ISR (`revalidate = 3600`), and a Worker has no
   * persistent filesystem, so the revalidation cache needs a real backend.
   * Without this binding `vinext-cloudflare deploy` refuses to deploy the app
   * at all ("This app uses ISR / caching but no cache adapter is configured").
   *
   * KV is the right home for it: this is a cache of WordPress blog reads, not
   * application state and not commerce data — an eviction costs one upstream
   * fetch. Commerce data (products, prices, stock, orders) is never cached
   * here; it is read from WooCommerce per request, because stock has to stay
   * live (see docs/CLOUDFLARE-MIGRATION.md, "Never cached").
   *
   * The id belongs to the account this Worker is deployed into, and that is not a
   * free choice: a Worker custom domain — which is how preview.himalayankoh.com is
   * attached — requires the zone and the Worker to be in the *same* account, and
   * `himalayankoh.com` lives in `Himalayankoh.pk@gmail.com`'s account
   * (fd383fa3284298b20cd3ca9ba8b1dffa). The Worker was first built in
   * `8002salman@gmail.com`'s account (f542683e97458480452b0b8ef37a898a), whose
   * namespace id was `1cab497b7f394525941245bc84ff43cb`; that deployment is kept as
   * rollback and still runs, but its binding is fixed at its last deploy, so this
   * file describes the live staging deployment only. A binding id is not a secret.
   */
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "7e62970fbe5049dfb678409d6f28d064"
    }
  ],

  /**
   * Public deployment configuration. These are inlined into the bundle at
   * build time, so the build must be given the same values (see the build
   * recipe in docs/CLOUDFLARE-MIGRATION.md); they are repeated here so a
   * runtime read of `process.env` agrees with what was compiled in.
   *
   * NEXT_PUBLIC_SITE_URL is the canonical origin — canonicals, JSON-LD, the
   * sitemap and checkout return URLs are all built from it. It must stay the
   * production domain even on a temporary deployment: the temporary host is
   * non-indexable (src/lib/seo/indexing.ts) and should point at the real home
   * rather than invent a canonical of its own.
   */
  /**
   * Public, non-secret values only — anything here is world-readable.
   *
   * `NEXT_PUBLIC_SITE_URL` is the staging/QA origin, because this Worker *is* the
   * staging deployment (preview.himalayankoh.com). Two traps, both learned the
   * hard way: the value is inlined into the bundle at build time, so the build
   * environment must be given the same origin or the runtime var is ignored
   * (`scripts/check-public-origin.mjs` fails the build if a loopback URL slips
   * in); and a production Worker must override this with
   * https://himalayankoh.com rather than inherit it. See src/lib/site/origin.ts.
   */
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://preview.himalayankoh.com",
    "NEXT_PUBLIC_DATA_SOURCE": "woocommerce",
    "NEXT_PUBLIC_WORDPRESS_BASE_URL": "https://himalayankoh.com/staging",
    "NEXT_PUBLIC_WOOCOMMERCE_BASE_URL": "https://himalayankoh.com/staging"
  },

  /**
   * Cloudflare Email Sending binding.
   * Allows the Worker to send outbound email via Cloudflare's email
   * infrastructure. Requires himalayankoh.com to have Cloudflare Email
   * Routing enabled. The sender address must use the domain.
   */
  "send_email": [
    {
      "name": "EMAIL_SENDER",
      "allowed_destinations": ["@himalayankoh.com"]
    }
  ]
}
