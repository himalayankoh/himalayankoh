# Backend data source
# Vercel preview currently uses WooCommerce/WordPress staging as the catalog source.
# Keep Supabase variables during migration as a rollback path until WooCommerce parity is complete.
NEXT_PUBLIC_DATA_SOURCE=woocommerce
NEXT_PUBLIC_WORDPRESS_BASE_URL=https://himalayankoh.com/staging
NEXT_PUBLIC_WOOCOMMERCE_BASE_URL=https://himalayankoh.com/staging
WORDPRESS_BASE_URL=https://himalayankoh.com/staging
WOOCOMMERCE_BASE_URL=https://himalayankoh.com/staging
WORDPRESS_REQUEST_TIMEOUT_MS=12000

# Optional WooCommerce REST v3 read credentials (server only).
# These are recommended while the public Store API product route on staging is failing.
# Never expose these as NEXT_PUBLIC_ variables and never commit real values.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Supabase — https://app.supabase.com/project/_/settings/api
# Retained temporarily as a rollback/development path during the WordPress/WooCommerce migration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Used by insert-himalayan-products.mjs (set in the shell or a local ignored env file):
SUPABASE_URL=https://your-project-id.supabase.co

# Server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key-here
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Stripe TEST mode
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL (Stripe return_url, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter AI (server only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# HubSpot CRM sync (server only) — Private App token with
# crm.objects.contacts read + write scopes. Can also be set in Admin → Settings.
HUBSPOT_ACCESS_TOKEN=

# Production live Stripe (optional)
# STRIPE_ALLOW_LIVE=true

# Shippo — test (shippo_test_...) or live (shippo_live_...) from Shippo → Settings → API
SHIPPO_API_KEY=shippo_test_...
NEXT_PUBLIC_SHIPPO_ENABLED=true
SHIPPO_FROM_NAME=Himalayan Koh
SHIPPO_FROM_STREET1=12620 FM 1960 W Ste A-4
SHIPPO_FROM_CITY=Houston
SHIPPO_FROM_STATE=TX
SHIPPO_FROM_ZIP=77065
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=8322246466
SHIPPO_FROM_EMAIL=orders@himalayankoh.com

# Transactional email (Resend) — https://resend.com
RESEND_API_KEY=
RESEND_FROM=Himalayan Koh <orders@himalayankoh.com>
ADMIN_NOTIFICATION_EMAIL=sales@himalayankoh.com

# Omnisend Email Marketing (Free Tier) — https://omnisend.com
OMNISEND_API_KEY=

# Legacy Vite names still work as fallbacks during migration:
# VITE_SUPABASE_URL= VITE_STRIPE_PUBLISHABLE_KEY=

# --- SEO / Search Console (owner-supplied; leave empty until the owner pastes) ---
# Server-side. Emits no <meta name="google-site-verification"> tag while empty, and
# does NOT make any non-production host indexable (see src/lib/seo/indexing.ts).
GOOGLE_SITE_VERIFICATION=

# --- AdSense (disabled until the owner approves activation) -----------------------
# Ads render only when ENABLED=true, CLIENT is a real ca-pub-… id, AND the request
# is on a production host. Staging/preview/workers.dev always render nothing.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
