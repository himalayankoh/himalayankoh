{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start:vinext -- --ip 127.0.0.1 --port 8787",
      "startServerReadyPattern": "Ready on|Listening on",
      "url": [
        "http://127.0.0.1:8787/",
        "http://127.0.0.1:8787/products",
        "http://127.0.0.1:8787/about"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["warn", { "minScore": 0.7 }],
        "categories:best-practices": ["warn", { "minScore": 0.7 }],
        "categories:seo": ["warn", { "minScore": 0.65 }],
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
