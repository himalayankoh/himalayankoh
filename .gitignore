node_modules
.env
.env.local
.env.*.local

.vercel
.next
out

# Generated by whichever toolchain last ran, and the two disagree about its
# contents: `vinext build` imports its own type augmentations, `next lint`/`next
# build` restore Next's navigation types. Tracked, it left the tree dirty after a
# lint run and hid real edits in the noise; typecheck passes without it (verified),
# and both build tools write it back before anything needs it.
next-env.d.ts

# Legacy Vite build output (Next.js uses .next)
dist
.env*

# TypeScript incremental build cache
tsconfig.tsbuildinfo
.DS_Store

# Supabase CLI local cache
supabase/.temp/
.branches
.build-marker
.vinext/
.wrangler/

# Cloudflare Worker secrets. `wrangler dev` reads these locally; a deployed
# Worker gets them from `wrangler secret put`. Neither belongs in git.
.dev.vars
.dev.vars.*

# Local Worker dev-server output (scripts/run-cloudflare-dev.mjs).
.cloudflare-dev*.log

# Owner-provided access details for the production migration: hosting, WordPress ad-
# min and API tokens that are not environment variables the app reads. Stored here so
# later sessions and the cutover do not have to ask for them again — and ignored so
# they can never be committed.
docs/production/*.local.*

# Scratch and probe workspaces
.freebuff/
scratch/


# WordPress plugin release artifacts (built by scripts/pack-plugins.mjs)
deploy/

# QA, browser profiles and data backups
# `backups/` holds read-only store exports and one-off incident reports: orders
# and customers are in there, so it must never be committed.
backups/
.chrome-qa-profile/
qa-visual-artifacts/
public/qa-screenshots/
supabase-backup/
preview-*.png
sales-*.png

# Per-record customer exports. Rows about people belong in backups/, never in docs/:
# `customer-cleanup-manifest-2026-10-11.csv` was committed here once, and a digest of an
# address's local part beside the domain in clear is not anonymous. The counts go in the
# document; `scripts/check-tracked-customer-data.mjs` fails the build if a tracked export
# reappears.
docs/production/*-cleanup-*.csv
docs/production/*-manifest-*.csv
docs/production/*-census-*.csv
docs/production/*-export-*.csv
docs/production/*customer*.csv

# SQLite research databases and runtime caches
*.sqlite
*.sqlite-journal
ops/leados/data/


# Android build outputs and local configuration
.gradle/
android/.gradle/
android/app/build/
android/local.properties
android/gradle/wrapper/gradle-wrapper.jar

